# PPM Backup Configuration
# Copy to .env.backup and fill in your values
# This file is used by scripts/backup.sh

# PostgreSQL Configuration
DB_NAME=ppm
DB_USER=postgres
DB_HOST=localhost
DB_PORT=5432

# Encryption Configuration
# Set this to your GPG recipient key ID or email
# Example: backup@ppm.local or 0x1234567890ABCDEF
GPG_RECIPIENT=backup@ppm.local

# AWS S3 Configuration (optional, for remote storage)
# Leave empty to skip S3 upload and use local-only backups
AWS_S3_BUCKET=ppm-backups
AWS_REGION=ap-northeast-1

# AWS credentials should be configured via:
# - ~/.aws/credentials
# - IAM role (if running on EC2)
# - Environment variables (AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY)
