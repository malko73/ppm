# PPM 環境設定ファイルテンプレート
# コピーして .env にリネームし、実際の値を設定してください
# cp .env.template .env

# Django Settings
DJANGO_SECRET_KEY=change-me-to-a-random-secret-key
DEBUG=False
ALLOWED_HOSTS=127.0.0.1,localhost,ppm.y-asahi.com

# MySQL Database
MYSQL_DATABASE=appsdb
MYSQL_USER=rocky
MYSQL_PASSWORD=change-me
MYSQL_HOST=localhost
MYSQL_PORT=3306

# SMTP (Email) - 必要な場合のみ設定
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=465
# EMAIL_USE_SSL=True
# EMAIL_HOST_USER=user@example.com
# EMAIL_HOST_PASSWORD=change-me

# AWS S3 (optional) - 本番S3使用時のみ設定
USE_S3=False
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_REGION_NAME=ap-northeast-1

# Celery / Redis
# Redis認証を使用する場合: redis://:<password>@localhost:6379/<db>
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CACHE_URL=redis://localhost:6379/2

# AUTH_LOG_SIGNING_KEY（認証ログ署名専用。SECRET_KEYとは独立して設定すること）
AUTH_LOG_SIGNING_KEY=change-me-to-an-independent-signing-key

# Font paths (optional - 環境変数でNotoフォントのパスを上書き指定)
# NOTO_SANS_JP_FONT_PATH=/path/to/NotoSansJP-Regular.otf
# NOTO_SANS_JP_BOLD_FONT_PATH=/path/to/NotoSansJP-Bold.otf
# NOTO_SERIF_JP_FONT_PATH=/path/to/NotoSerifJP-Regular.otf
# NOTO_SERIF_JP_BOLD_FONT_PATH=/path/to/NotoSerifJP-Bold.otf
